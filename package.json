{
  "name": "skate-penguin",
  "version": "0.1.0",
  "description": "A tiny pixel-art skateboarding penguin desktop companion.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mikefromrematch.skatepenguin",
    "productName": "Skate Penguin",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.game"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
